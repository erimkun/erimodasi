{
  "name": "erimodasi",
  "version": "1.0.0",
  "description": "Erim's Room - GLB Editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/gh-pages-spa.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "perf:install": "playwright install chromium",
    "perf:test": "playwright test -c playwright.perf.config.ts",
    "perf:run": "npm run build && npm run perf:test",
    "perf:test:standard": "set PERF_QUALITY=standard&& playwright test -c playwright.perf.config.ts",
    "perf:test:boost": "set PERF_QUALITY=boost&& playwright test -c playwright.perf.config.ts",
    "perf:ab": "npm run build && npm run perf:test:standard && npm run perf:test:boost && node scripts/perf-ab-report.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erimkun/erimodasi.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/erimkun/erimodasi/issues"
  },
  "homepage": "https://erimkun.github.io/erimodasi/",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.3",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "gh-pages": "^6.3.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "framer-motion": "^12.33.0",
    "leva": "^0.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.8",
    "webgl-fluid-simulation": "^1.0.0",
    "zustand": "^5.0.11"
  }
}
